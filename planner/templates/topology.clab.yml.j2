# Generated from the addressing plan. Deploy with: sudo containerlab deploy -t topology.clab.yml
name: {{ lab_name }}
topology:
  nodes:
{% for r in routers %}
    {{ r.name }}:
      kind: linux
      image: {{ frr_image }}
      binds:
        - configs/{{ r.name }}/daemons:/etc/frr/daemons
        - configs/{{ r.name }}/frr.conf:/etc/frr/frr.conf
      exec:
        - "sysctl -w net.ipv4.ip_forward=1"
        - "sysctl -w net.ipv6.conf.all.forwarding=1"
{% endfor %}
{% for h in hosts %}
    {{ h.name }}:
      kind: linux
      image: {{ host_image }}
      exec:
        - "ip addr add {{ h.ipv4_cidr }} dev eth1"
        - "ip -6 addr add {{ h.ipv6_cidr }} dev eth1"
        - "ip route replace default via {{ h.gw4 }}"
        - "ip -6 route replace default via {{ h.gw6 }}"
{% endfor %}
  links:
{% for a, b in links %}
    - endpoints: ["{{ a }}", "{{ b }}"]
{% endfor %}
