# Generated from the addressing plan.
# Deploy:    sudo containerlab deploy -t topology.clab.yml
# Then run:  python3 -m planner.cli configure --plan <plan.json>   (gives the test hosts their addresses)
name: {{ lab_name }}
topology:
  nodes:
{% for r in routers %}
    {{ r.name }}:
      kind: linux
      image: {{ frr_image }}
      binds:
        - configs/{{ r.name }}/daemons:/etc/frr/daemons
        - configs/{{ r.name }}/frr.conf:/etc/frr/frr.conf
        - configs/{{ r.name }}/vtysh.conf:/etc/frr/vtysh.conf
{% endfor %}
{% for h in hosts %}
    {{ h.name }}:
      kind: linux
      image: {{ host_image }}
{% endfor %}
  links:
{% for a, b in links %}
    - endpoints: ["{{ a }}", "{{ b }}"]
{% endfor %}
