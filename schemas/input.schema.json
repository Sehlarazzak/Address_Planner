{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Planner input (site requirements)",
  "type": "object",
  "required": ["organization", "ipv4_block", "ipv6_prefix", "sites", "links"],
  "additionalProperties": false,
  "properties": {
    "organization": { "type": "string", "minLength": 1 },
    "ipv4_block": { "type": "string", "pattern": "^[0-9]{1,3}(\\.[0-9]{1,3}){3}/[0-9]{1,2}$" },
    "ipv6_prefix": { "type": "string", "pattern": "^[0-9a-fA-F:]+/48$" },
    "sites": { "type": "array", "minItems": 2, "maxItems": 14, "items": { "$ref": "#/$defs/site" } },
    "links": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/link" } }
  },
  "$defs": {
    "site": {
      "type": "object",
      "required": ["name", "router", "subnets"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "router": { "type": "string", "minLength": 1 },
        "subnets": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/lan" } }
      }
    },
    "lan": {
      "type": "object",
      "required": ["name", "hosts", "growth_pct"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "hosts": { "type": "integer", "minimum": 1, "maximum": 65533 },
        "growth_pct": { "type": "integer", "minimum": 0, "maximum": 500 }
      }
    },
    "link": {
      "type": "object",
      "required": ["name", "a", "b"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "a": { "type": "string", "minLength": 1 },
        "b": { "type": "string", "minLength": 1 }
      }
    }
  }
}
